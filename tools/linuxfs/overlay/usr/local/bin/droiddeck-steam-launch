#!/bin/bash
set -u
ui=${1:-desktop}
target=${2:-}
case $ui in desktop|bigpicture) ;; *) echo "usage: $0 desktop|bigpicture [appid|steam://url]" >&2; exit 64 ;; esac
url=
case $target in
  "") ;;
  steam://*) url=$target ;;
  *[!0-9]*) echo "not an app id or steam:// URL: $target" >&2; exit 64 ;;
  *) url=steam://rungameid/$target ;;
esac

desktop_note() {
  # A click that only waits has nothing to show for itself, so put a word on the desktop
  # when the session can. Never fatal: this is a nicety, not a step in the launch.
  local msg=$1
  # without a session bus there is nobody to notify, and the call would just hang
  [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || return 0
  command -v notify-send >/dev/null 2>&1 &&
    notify-send -a DroidDeck "$msg" >/dev/null 2>&1 && return 0
  command -v kdialog >/dev/null 2>&1 &&
    kdialog --title DroidDeck --passivepopup "$msg" 10 >/dev/null 2>&1 && return 0
  return 0
}

if [ "$ui" = desktop ] && [ "${BL_DESKTOP:-}" = 1 ]; then
  # A click on the desktop icon leaves this process with nowhere to print, and the session
  # it starts is nested, so a silent failure here is indistinguishable from a dead icon.
  # Keep a copy of everything in the debug directory, which the session report collects.
  if [ -n "${BL_DEBUG_DIR:-}" ]; then
    mkdir -p "$BL_DEBUG_DIR" 2>/dev/null || true
    exec >>"$BL_DEBUG_DIR/steam-desktop.log" 2>&1
    echo "== droiddeck-steam-launch $(date -u '+%Y-%m-%d %H:%M:%S UTC') $*"
    echo "==   WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-none} DISPLAY=${DISPLAY:-none} HOME=${HOME:-none}"
  fi
  steam_root=${XDG_DATA_HOME:-${HOME:-/root}/.local/share}/Steam
  export LD_LIBRARY_PATH=$steam_root/steamrtarm64:$steam_root/steamrtarm64/panorama${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/droiddeck"
  exec 9>"${XDG_CACHE_HOME:-$HOME/.cache}/droiddeck/steam-desktop.lock"
  if ! flock -n 9; then
    # Another launch already owns the client. On a fresh home that means the client is still
    # downloading, which takes minutes and has no window to show for it, so a click looks
    # dead when it is only early. Wait it out while that launch is still doing something,
    # and say so where a user can see it. stderr, not stdout: stdout is the client's channel
    # and the tests assert on it.
    echo "== the desktop lock is held, waiting for the running client" >&2
    desktop_note "Steam is still being set up; it opens as soon as it is ready."
    for ((attempt = 0; attempt < 1200; attempt++)); do
      pid=$(cat "$HOME/.steam/steam.pid" 2>/dev/null || true)
      if [ -p "$HOME/.steam/steam.pipe" ] && [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        echo "== handing $* to the running client (pid $pid)" >&2
        exec "$steam_root/steamrtarm64/steam" -nobigpicture -no-cef-sandbox \
          -cef-ozone-platform=x11 -cef-disable-gpu "${url:-steam://open/library}"
      fi
      if [ $((attempt % 20)) = 0 ]; then
        echo "== still waiting: pid=${pid:-none} pipe=$( [ -p "$HOME/.steam/steam.pipe" ] && echo yes || echo no)" >&2
        setting_up=$(pgrep -f 'droiddeck-session steam|droiddeck-steam-install' 2>/dev/null | tr '\n' ' ')
        if [ -n "$setting_up" ]; then
          echo "== still waiting: the client is still being set up ($setting_up)" >&2
        elif [ "$attempt" -ge 120 ]; then
          echo "== the client did not come up and nothing is starting it any more" >&2
          break
        fi
      fi
      sleep 0.5
    done
    echo "droiddeck-steam-launch: the desktop client did not become ready" >&2
    exit 69
  fi
  export BL_INSIDE=1 BL_STEAM_UI=desktop
  echo "== starting a client through droiddeck-session steam ${url:-steam://open/library}" >&2
  exec /usr/local/bin/droiddeck-session steam "${url:-steam://open/library}"
fi

dir=${BL_LAUNCH_DIR:-}
if [ -z "$dir" ] || [ ! -d "$dir" ]; then
  echo "droiddeck-steam-launch: not inside a DroidDeck session (BL_LAUNCH_DIR unset)" >&2
  exit 69
fi
printf 'ui=%s\nurl=%s\n' "$ui" "$url" > "$dir/steam-launch.tmp" && mv -f "$dir/steam-launch.tmp" "$dir/steam-launch"
echo "droiddeck-steam-launch: asked the app for Steam ($ui${url:+, $url})"
