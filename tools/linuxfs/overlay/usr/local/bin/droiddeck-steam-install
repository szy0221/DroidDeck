#!/bin/bash
set -eu
cdn=https://client-update.fastly.steamstatic.com
# Every session that repairs or first-installs the client pulls ~1 GB through
# whatever link the phone is on, and one host being unreachable used to lose the
# whole download. These are the hosts Steam itself keeps in update_hosts_cached,
# plus one the client was seen preferring; each part is checked against the
# manifest's sha2, so a host serving something else is rejected, not installed.
hosts=("$cdn" https://client-update.akamai.steamstatic.com https://client-update.steamstatic.com
       https://media.st.dl.eccdnx.com/client https://client-update.queniuqe.com)
if [ -n "${DROIDDECK_STEAM_CDN:-}" ]; then
  hosts=("$DROIDDECK_STEAM_CDN" "${hosts[@]}")
fi
# fetch <path on the host> <file to write>
#
# Walk the hosts above, three attempts on the preferred one (resuming the bytes
# already on disk, because a reset mid-stream is usually transient) and one each
# on the rest. Below 1 KiB/s for a whole minute is not a download, it is a dead
# tunnel, so give up on that attempt instead of sitting there looking hung.
fetch() {
  local path=$1 out=$2 host attempt tries rc=1 first=1
  for host in "${hosts[@]}"; do
    rm -f "$out"
    # The preferred host gets retried: a connection reset mid-stream is usually
    # transient, and resuming keeps the bytes already pulled. The fallbacks get
    # one try each, so a network that is really down fails in minutes, not hours.
    tries=1
    [ "$first" = 1 ] && tries=3 && first=0
    for ((attempt = 1; attempt <= tries; attempt++)); do
      if [ "$attempt" -eq 1 ]; then
        curl -fsSL "$host/$path" -o "$out" --connect-timeout 20 \
             --speed-time 60 --speed-limit 1024 && return 0
      else
        curl -fsSL "$host/$path" -o "$out" -C - --connect-timeout 20 \
             --speed-time 60 --speed-limit 1024 && return 0
      fi
      rc=$?
      echo "== STEP $(date -u +%H:%M:%S) retrying $path from ${host#*//} (attempt $attempt failed, rc=$rc)"
      sleep 3
    done
  done
  echo "droiddeck-steam-install: no download host would serve $path" >&2
  return $rc
}
steam_channel=steamdeck_publicbeta
manifest=steam_client_${steam_channel}_linuxarm64
steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
stamp=$steam_root/package/droiddeck-installed
legacy_stamp=$steam_root/package/bannerlator-installed
unconfirmed=$steam_root/package/droiddeck-unconfirmed
repair_request=$HOME/.bl-steam-repair
if [ -f "$legacy_stamp" ] && [ ! -f "$stamp" ]; then
  mv -f "$legacy_stamp" "$stamp" || true
fi
repair=""
if [ -e "$repair_request" ]; then
  repair="requested"
elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" \
    && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
  repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
fi
if [ -n "$repair" ]; then
  echo "== STEP $(date -u +%H:%M:%S) repairing the Steam client ($repair)"
  rm -f "$stamp" "$legacy_stamp" "$steam_root/.crash" "$steam_root/steam.pid" \
    "$steam_root"/package/steam_client_*.manifest "$steam_root"/package/steam_client_*.installed
  for part in "$steam_root"/package/*.zip.*; do
    [ -f "$part" ] || continue
    sum=${part##*.}
    sum=${sum%%_*}
    case $sum in
      *[!0-9a-f]*|"") continue ;;
    esac
    [ ${#sum} -eq 40 ] || continue
    [ "$(sha1sum "$part" | cut -d' ' -f1)" = "$sum" ] || rm -f "$part"
  done
fi
[ -x "$steam_root/steamrtarm64/steam" ] && [ -f "$stamp" ] && exit 0

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fetch "$manifest" "$work/manifest"
version=$(awk -F'"' '$2 == "version" { print $4; exit }' "$work/manifest")
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  END { for (b in file) if (b ~ /_all$/ || b ~ /_linuxarm64_linuxarm64$/) print b, file[b], sha[b] }
' "$work/manifest" | sort > "$work/parts"
[ -s "$work/parts" ] || { echo "droiddeck-steam-install: no client components in $manifest" >&2; exit 1; }
total=$(grep -c . "$work/parts" 2>/dev/null || echo 0)

mkdir -p "$steam_root/package"
while read -r block file sum; do
  i=$((${i:-0} + 1))
  echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($i/$total)"
  fetch "$file" "$work/$file"
  echo "$sum  $work/$file" | sha256sum -c --quiet
  unzip -qo "$work/$file" -d "$steam_root"
  rm -f "$work/$file"
done < "$work/parts"
find "$steam_root" -depth -name '*\\*' | while read -r odd; do
  fixed=${odd//\\//}
  mkdir -p "$(dirname "$fixed")"
  if [ -d "$odd" ]; then
    cp -a "$odd/." "$fixed/" && rm -rf "$odd"
  else
    mv -f "$odd" "$fixed"
  fi
done
echo "$steam_channel" > "$steam_root/package/beta"
ln -sfn "$steam_root/steamrtarm64" "$steam_root/steamrtarm32"
chmod +x "$steam_root/steamrtarm64/steam" 2>/dev/null || true
mkdir -p "$HOME/.steam"
ln -sfn "$steam_root" "$HOME/.steam/root"
ln -sfn "$steam_root" "$HOME/.steam/steam"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/bin64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdk64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdkarm64"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/binarm64"
ln -sfn "$steam_root/linux32" "$HOME/.steam/sdk32"
echo "$version" > "$stamp"
if [ -n "$repair" ]; then
  echo repaired > "$unconfirmed"
  rm -f "$repair_request"
fi
