#!/bin/bash
set -eu
cdn=${DROIDDECK_STEAM_CDN:-https://client-update.fastly.steamstatic.com}
cdn_hosts="$cdn
https://media.steamstatic.com
https://steamcdn-a.akamaihd.net
https://client-update.akamaihd.net"
steam_channel=steamdeck_publicbeta
manifest=steam_client_${steam_channel}_linuxarm64
steam_root=${XDG_DATA_HOME:-$HOME/.local/share}/Steam
stamp=$steam_root/package/droiddeck-installed
legacy_stamp=$steam_root/package/bannerlator-installed
unconfirmed=$steam_root/package/droiddeck-unconfirmed
repair_request=$HOME/.bl-steam-repair
if [ -f "$legacy_stamp" ] && [ ! -f "$stamp" ]; then
  mv -f "$legacy_stamp" "$stamp" || true
fi
repair=""
if [ -e "$repair_request" ]; then
  repair="requested"
elif [ -f "$unconfirmed" ] && ! grep -qx repaired "$unconfirmed" \
    && [ "$(grep -cx start "$unconfirmed")" -ge 2 ]; then
  repair="the client was started $(grep -cx start "$unconfirmed") times without showing anything"
fi
if [ -n "$repair" ]; then
  echo "== STEP $(date -u +%H:%M:%S) repairing the Steam client ($repair)"
  # The cached archives are suspect too - otherwise a repair would happily
  # reinstall the very bytes that just failed to start.
  rm -f "$steam_root"/package/droiddeck-cache/*
  rm -f "$stamp" "$legacy_stamp" "$steam_root/.crash" "$steam_root/steam.pid" \
    "$steam_root"/package/steam_client_*.manifest "$steam_root"/package/steam_client_*.installed
  for part in "$steam_root"/package/*.zip.*; do
    [ -f "$part" ] || continue
    sum=${part##*.}
    sum=${sum%%_*}
    case $sum in
      *[!0-9a-f]*|"") continue ;;
    esac
    [ ${#sum} -eq 40 ] || continue
    [ "$(sha1sum "$part" | cut -d' ' -f1)" = "$sum" ] || rm -f "$part"
  done
fi
[ -x "$steam_root/steamrtarm64/steam" ] && [ -f "$stamp" ] && exit 0

# fetch <path> <dest> [sha256]
#
# Walks every known Steam CDN in turn and keeps what it already has, because the
# client is several hundred MB and one dropped TLS connection - routine behind a
# VPN or an unreliable link - used to abort the whole session and drop the user
# back to the launcher. Returns only when the checksum matches.
fetch() {
  local path=$1 dest=$2 want=${3:-} host url attempt rc
  mkdir -p "$(dirname "$dest")"
  for attempt in 1 2 3; do
    for host in $cdn_hosts; do
      url=$host/$path
      [ -f "$dest" ] || : > "$dest"
      if ! curl -fSL --retry 3 --retry-delay 2 \
          --connect-timeout 20 --max-time 900 --speed-time 60 --speed-limit 1024 \
          -C - "$url" -o "$dest" 2>"$dest.log"; then
        rc=$?
        echo "== STEP $(date -u +%H:%M:%S) ${host#https://} attempt $attempt failed (curl $rc: $(tail -1 "$dest.log"))"
      fi
      if [ -z "$want" ] && [ -s "$dest" ]; then rm -f "$dest.log"; return 0; fi
      if [ -n "$want" ] && [ "$(sha256sum "$dest" | cut -d' ' -f1)" = "$want" ]; then
        rm -f "$dest.log"
        return 0
      fi
      # Wrong bytes: a resumed file from an older client, or a mirror serving
      # something else. Drop it so the next attempt really starts over.
      rm -f "$dest"
    done
    sleep $((attempt * 3))
  done
  rm -f "$dest.log"
  return 1
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
fetch "$manifest" "$work/manifest" || {
  echo "droiddeck-steam-install: could not download the client manifest" >&2
  exit 1
}
version=$(awk -F'"' '$2 == "version" { print $4; exit }' "$work/manifest")
awk -F'"' '
  /^\t"/ && NF >= 3 && $4 == "" { block = $2 }
  $2 == "file" { file[block] = $4 }
  $2 == "sha2" { sha[block] = $4 }
  END { for (b in file) if (b ~ /_all$/ || b ~ /_linuxarm64_linuxarm64$/) print b, file[b], sha[b] }
' "$work/manifest" | sort > "$work/parts"
[ -s "$work/parts" ] || { echo "droiddeck-steam-install: no client components in $manifest" >&2; exit 1; }
total=$(grep -c . "$work/parts" 2>/dev/null || echo 0)

mkdir -p "$steam_root/package"
# Kept between runs: a session that dies half way through can pick up where it
# stopped instead of pulling several hundred MB again from zero.
cache=$steam_root/package/droiddeck-cache
mkdir -p "$cache"
while read -r block file sum; do
  i=$((${i:-0} + 1))
  if [ -f "$cache/$file" ] && [ "$(sha256sum "$cache/$file" | cut -d' ' -f1)" = "$sum" ]; then
    echo "== STEP $(date -u +%H:%M:%S) already downloaded Steam: $block ($i/$total)"
  else
    echo "== STEP $(date -u +%H:%M:%S) downloading Steam: $block ($i/$total)"
    fetch "$file" "$cache/$file" "$sum" || {
      echo "droiddeck-steam-install: could not download $file" >&2
      exit 1
    }
  fi
  unzip -qo "$cache/$file" -d "$steam_root"
done < "$work/parts"
find "$steam_root" -depth -name '*\\*' | while read -r odd; do
  fixed=${odd//\\//}
  mkdir -p "$(dirname "$fixed")"
  if [ -d "$odd" ]; then
    cp -a "$odd/." "$fixed/" && rm -rf "$odd"
  else
    mv -f "$odd" "$fixed"
  fi
done
echo "$steam_channel" > "$steam_root/package/beta"
ln -sfn "$steam_root/steamrtarm64" "$steam_root/steamrtarm32"
chmod +x "$steam_root/steamrtarm64/steam" 2>/dev/null || true
mkdir -p "$HOME/.steam"
ln -sfn "$steam_root" "$HOME/.steam/root"
ln -sfn "$steam_root" "$HOME/.steam/steam"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/bin64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdk64"
ln -sfn "$steam_root/linuxarm64" "$HOME/.steam/sdkarm64"
ln -sfn "$steam_root/steamrtarm64" "$HOME/.steam/binarm64"
ln -sfn "$steam_root/linux32" "$HOME/.steam/sdk32"
echo "$version" > "$stamp"
if [ -n "$repair" ]; then
  echo repaired > "$unconfirmed"
  rm -f "$repair_request"
fi
